{
  "description": "Adds the shared-decisions instruction to each session of a linked repository (034 research R1).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
